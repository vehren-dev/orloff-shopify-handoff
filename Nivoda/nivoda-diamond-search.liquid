<script>
(function () {
  var API_BASE = 'https://orloff-nivoda-proxy.orloffofdenmark.workers.dev';
  var PAGE_SIZE = 24;

  var COLOR_SCALE = ['K', 'J', 'I', 'H', 'G', 'F', 'E', 'D'];
  var CLARITY_SCALE = ['VS2', 'VS1', 'VVS2', 'VVS1', 'IF', 'FL'];
  var CUT_SCALE = ['GD', 'VG', 'EX', 'ID'];

  var state = {
    shapes: ['ROUND'],
    labgrown: 'false',
    colorTone: 'white',
    color: [],
    fancyColor: '',
    fancyIntensity: '',
    fancyOvertone: '',
    clarity: [],
    cut: [],
    polish: [],
    symmetry: [],
    eyeClean: '',
    heartsArrows: false,
    caratMin: '',
    caratMax: '',
    priceMin: '',
    priceMax: '',
    sortBy: 'price',
    direction: 'ASC',
    offset: 0,
    total: 0,
  };
  var lastQueryString = '';
  var initializing = true;

  var listingEl = document.getElementById('ds-listing');
  var detailEl = document.getElementById('ds-detail');
  var gridEl = document.getElementById('diamond-grid');
  var countEl = document.getElementById('diamond-result-count');
  var sortEl = document.getElementById('diamond-sort');
  var loadMoreEl = document.getElementById('ds-load-more');
  var itemsById = {};

  /* ---------------- Filter controls (chips + batch apply) ---------------- */

  // Single-select groups: shape and the Natural/Lab tabs. Update state; no search
  // until Apply is clicked.
  function wireSingleSelect(containerSel, itemSel, onSelect) {
    var container = document.querySelector(containerSel);
    if (!container) return;
    container.addEventListener('click', function (e) {
      var btn = e.target.closest(itemSel);
      if (!btn) return;
      container.querySelectorAll(itemSel).forEach(function (b) { b.classList.remove('is-active'); });
      btn.classList.add('is-active');
      onSelect(btn);
    });
  }
  // Shape: multi-select and deselectable — each click toggles that shape on/off,
  // and state.shapes collects every active one (empty = all shapes).
  document.querySelector('.diamond-shape-row').addEventListener('click', function (e) {
    var btn = e.target.closest('.diamond-shape-swatch');
    if (!btn) return;
    btn.classList.toggle('is-active');
    var vals = [];
    document.querySelectorAll('.diamond-shape-row .diamond-shape-swatch.is-active').forEach(function (b) {
      vals.push((b.getAttribute('data-shape') || '').toUpperCase());
    });
    state.shapes = vals;
  });
  // Natural / Lab stays single-select (one is always active). The tabs live in
  // the sticky bar outside the drawer, so switching re-runs the search at once.
  wireSingleSelect('.diamond-source-tabs', '.diamond-source-tab', function (btn) {
    state.labgrown = btn.getAttribute('data-source') === 'lab' ? 'true' : 'false';
    runSearch(true);
  });

  // Multi-select chip groups: colour / clarity / cut.
  function wireMultiChips(containerId, attr, apply) {
    var container = document.getElementById(containerId);
    if (!container) return;
    container.addEventListener('click', function (e) {
      var btn = e.target.closest('.ds-chip');
      if (!btn) return;
      btn.classList.toggle('is-active');
      var vals = [];
      container.querySelectorAll('.ds-chip.is-active').forEach(function (b) { vals.push(b.getAttribute(attr)); });
      apply(vals);
    });
  }
  wireMultiChips('ds-color-grid', 'data-color', function (v) { state.color = v; });
  wireMultiChips('ds-clarity-row', 'data-clar', function (v) { state.clarity = v; });
  wireMultiChips('ds-cut-row', 'data-cut', function (v) { state.cut = v; clearCpsPresets(); });
  wireMultiChips('ds-polish-row', 'data-pol', function (v) { state.polish = v; clearCpsPresets(); });
  wireMultiChips('ds-symmetry-row', 'data-sym', function (v) { state.symmetry = v; clearCpsPresets(); });

  /* Cut/Polish/Symmetry quick presets. 3EX / EX Cut / 3VG+ are shortcuts that
     drive the three rows below (so shoppers see exactly what they imply);
     Hearts & Arrows is an independent boolean filter. */
  var cpsPresetsEl = document.getElementById('ds-cps-presets');

  function clearCpsPresets() {
    if (!cpsPresetsEl) return;
    cpsPresetsEl.querySelectorAll('.ds-chip.is-active:not([data-preset="ha"])').forEach(function (b) {
      b.classList.remove('is-active');
    });
  }

  function setChipRow(rowId, attr, values) {
    var row = document.getElementById(rowId);
    if (!row) return;
    row.querySelectorAll('.ds-chip').forEach(function (b) {
      b.classList.toggle('is-active', values.indexOf(b.getAttribute(attr)) !== -1);
    });
  }

  if (cpsPresetsEl) {
    cpsPresetsEl.addEventListener('click', function (e) {
      var btn = e.target.closest('.ds-chip');
      if (!btn) return;
      var preset = btn.getAttribute('data-preset');
      if (preset === 'ha') {
        btn.classList.toggle('is-active');
        state.heartsArrows = btn.classList.contains('is-active');
        return;
      }
      var wasActive = btn.classList.contains('is-active');
      clearCpsPresets();
      if (wasActive) {
        state.cut = []; state.polish = []; state.symmetry = [];
      } else {
        btn.classList.add('is-active');
        if (preset === '3ex') { state.cut = ['EX']; state.polish = ['EX']; state.symmetry = ['EX']; }
        else if (preset === 'excut') { state.cut = ['EX']; state.polish = []; state.symmetry = []; }
        else if (preset === '3vg') { state.cut = ['EX', 'VG']; state.polish = ['EX', 'VG']; state.symmetry = ['EX', 'VG']; }
      }
      setChipRow('ds-cut-row', 'data-cut', state.cut);
      setChipRow('ds-polish-row', 'data-pol', state.polish);
      setChipRow('ds-symmetry-row', 'data-sym', state.symmetry);
    });
  }

  // Colour White/Fancy toggle.
  var colorGridEl = document.getElementById('ds-color-grid');
  var colorHintEl = document.getElementById('ds-color-hint');
  var fancyFieldsEl = document.getElementById('ds-fancy-fields');
  document.querySelector('.diamond-toggle-pair').addEventListener('click', function (e) {
    var btn = e.target.closest('button');
    if (!btn) return;
    document.querySelectorAll('.diamond-toggle-pair button').forEach(function (b) { b.classList.remove('is-active'); });
    btn.classList.add('is-active');
    state.colorTone = btn.getAttribute('data-tone') || 'white';
    var isFancy = state.colorTone === 'fancy';
    if (colorGridEl) colorGridEl.hidden = isFancy;
    if (colorHintEl) colorHintEl.hidden = isFancy;
    if (fancyFieldsEl) fancyFieldsEl.hidden = !isFancy;
    if (isFancy && colorGridEl) {
      colorGridEl.querySelectorAll('.ds-chip.is-active').forEach(function (b) { b.classList.remove('is-active'); });
      state.color = [];
    }
  });

  // Fancy colour / intensity / overtone: single-select, click again to clear.
  function wireFancyRow(rowId, key) {
    var row = document.getElementById(rowId);
    if (!row) return;
    row.addEventListener('click', function (e) {
      var btn = e.target.closest('.ds-chip');
      if (!btn) return;
      var wasActive = btn.classList.contains('is-active');
      row.querySelectorAll('.ds-chip.is-active').forEach(function (b) { b.classList.remove('is-active'); });
      if (!wasActive) btn.classList.add('is-active');
      state[key] = wasActive ? '' : (btn.getAttribute('data-fval') || '');
    });
  }
  wireFancyRow('ds-fancy-color-row', 'fancyColor');
  wireFancyRow('ds-fancy-intensity-row', 'fancyIntensity');
  wireFancyRow('ds-fancy-overtone-row', 'fancyOvertone');
  wireFancyRow('ds-eyeclean-row', 'eyeClean'); // same single-select behaviour

  function clearFancyChips() {
    document.querySelectorAll('#ds-fancy-fields .ds-chip.is-active').forEach(function (b) { b.classList.remove('is-active'); });
  }

  // Carat quick-pick chips (single-select) + free-text min/max inputs.
  var caratMinEl = document.getElementById('ds-carat-min');
  var caratMaxEl = document.getElementById('ds-carat-max');
  var caratChipsEl = document.getElementById('ds-carat-chips');
  if (caratChipsEl) {
    caratChipsEl.addEventListener('click', function (e) {
      var btn = e.target.closest('.ds-chip');
      if (!btn) return;
      var wasActive = btn.classList.contains('is-active');
      caratChipsEl.querySelectorAll('.ds-chip').forEach(function (b) { b.classList.remove('is-active'); });
      if (wasActive) {
        caratMinEl.value = ''; caratMaxEl.value = '';
      } else {
        btn.classList.add('is-active');
        caratMinEl.value = btn.getAttribute('data-cmin');
        caratMaxEl.value = btn.getAttribute('data-cmax');
      }
    });
  }
  [caratMinEl, caratMaxEl].forEach(function (el) {
    if (el) el.addEventListener('input', function () {
      caratChipsEl.querySelectorAll('.ds-chip.is-active').forEach(function (b) { b.classList.remove('is-active'); });
    });
  });

  var priceMinEl = document.getElementById('ds-price-min');
  var priceMaxEl = document.getElementById('ds-price-max');

  function numOrBlank(v) {
    var n = parseFloat(String(v).replace(/[^0-9.]/g, ''));
    return isNaN(n) ? '' : n;
  }

  // Apply / Reset.
  document.getElementById('ds-apply').addEventListener('click', function () {
    state.caratMin = numOrBlank(caratMinEl.value);
    state.caratMax = numOrBlank(caratMaxEl.value);
    state.priceMin = numOrBlank(priceMinEl.value);
    state.priceMax = numOrBlank(priceMaxEl.value);
    // fancy colour/intensity/overtone update state directly on chip click
    runSearch(true);
    closeDrawer();
  });

  document.getElementById('ds-reset').addEventListener('click', function () {
    document.querySelectorAll('.diamond-shape-row .diamond-shape-swatch').forEach(function (b, i) {
      b.classList.toggle('is-active', i === 0);
    });
    document.querySelectorAll('.diamond-source-tabs .diamond-source-tab').forEach(function (b) {
      b.classList.toggle('is-active', b.getAttribute('data-source') === 'natural');
    });
    document.querySelectorAll('.diamond-toggle-pair button').forEach(function (b) {
      b.classList.toggle('is-active', b.getAttribute('data-tone') === 'white');
    });
    document.querySelectorAll('.ds-chip.is-active').forEach(function (b) { b.classList.remove('is-active'); });
    if (colorGridEl) colorGridEl.hidden = false;
    if (colorHintEl) colorHintEl.hidden = false;
    if (fancyFieldsEl) fancyFieldsEl.hidden = true;
    caratMinEl.value = ''; caratMaxEl.value = '';
    priceMinEl.value = ''; priceMaxEl.value = '';
    state.shapes = ['ROUND']; state.labgrown = 'false'; state.colorTone = 'white';
    state.color = []; state.clarity = []; state.cut = [];
    state.polish = []; state.symmetry = []; state.eyeClean = ''; state.heartsArrows = false;
    state.caratMin = ''; state.caratMax = ''; state.priceMin = ''; state.priceMax = '';
    state.fancyColor = ''; state.fancyIntensity = ''; state.fancyOvertone = '';
    runSearch(true);
  });

  /* ---------------- Filter drawer (slides down from the top) ---------------- */
  var drawerEl = document.getElementById('ds-drawer');
  var drawerBackdropEl = document.getElementById('ds-drawer-backdrop');
  var allFiltersBtnEl = document.getElementById('ds-open-filters');

  function openDrawer() {
    drawerEl.classList.add('is-open');
    drawerBackdropEl.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    drawerEl.classList.remove('is-open');
    drawerBackdropEl.classList.remove('is-open');
    document.body.style.overflow = '';
  }
  allFiltersBtnEl.addEventListener('click', openDrawer);
  document.getElementById('ds-drawer-close').addEventListener('click', closeDrawer);
  drawerBackdropEl.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && drawerEl.classList.contains('is-open')) closeDrawer();
  });

  /* ---------------- Sticky thin bar + auto-hiding theme header ----------------
     The theme's overflow wrappers break position:sticky, so the bar is pinned
     with JS. Page-scoped bonus: the theme header hides when scrolling down and
     glides back after a short scroll up, so the bar can own the top edge. */
  var topbarEl = document.querySelector('.ds-topbar');
  var topbarSpacer = document.createElement('div');
  topbarSpacer.style.display = 'none';
  topbarEl.parentNode.insertBefore(topbarSpacer, topbarEl.nextSibling);
  var topbarStuck = false;

  // The theme header section wrapper (OS 2.0 section-group ids vary by theme).
  var headerSection = document.querySelector('#shopify-section-header') ||
    document.querySelector('[id^="shopify-section-"][id*="header"]');
  if (!headerSection) {
    var themeHeader = document.querySelector('header');
    if (themeHeader && !listingEl.contains(themeHeader)) headerSection = themeHeader;
  }
  var headerHidden = false;
  var lastY = window.pageYOffset;
  var upTravel = 0;
  // Fade the whole header in/out (same feel as the home page header).
  if (headerSection) headerSection.style.transition = 'opacity 0.3s ease, visibility 0.3s ease';

  // How far down the visible bottom edge of the header currently is. A faded
  // header keeps its rect, so treat it as gone the moment it starts fading;
  // the bar's own top transition carries the movement smoothly.
  function headerBottom() {
    if (!headerSection || headerHidden) return 0;
    var r = headerSection.getBoundingClientRect();
    if (!r.height) return 0;
    return Math.max(0, r.bottom);
  }

  function syncTopbar() {
    var hb = headerBottom();
    if (!topbarStuck) {
      if (topbarEl.getBoundingClientRect().top <= hb) {
        topbarSpacer.style.height = topbarEl.offsetHeight + 'px';
        topbarSpacer.style.display = 'block';
        topbarEl.classList.add('is-stuck');
        topbarEl.style.top = hb + 'px';
        topbarStuck = true;
      }
    } else {
      topbarEl.style.top = hb + 'px';
      if (topbarSpacer.getBoundingClientRect().top > hb) {
        topbarEl.classList.remove('is-stuck');
        topbarEl.style.top = '';
        topbarSpacer.style.display = 'none';
        topbarStuck = false;
      }
    }
  }

  function setHeaderHidden(hide) {
    headerHidden = hide;
    headerSection.style.opacity = hide ? '0' : '';
    headerSection.style.visibility = hide ? 'hidden' : '';
    headerSection.style.pointerEvents = hide ? 'none' : '';
    syncTopbar(); // bar's top transition animates it to/from the header edge
  }

  window.addEventListener('scroll', function () {
    var y = window.pageYOffset;
    if (headerSection) {
      var delta = y - lastY;
      if (delta > 2) {
        upTravel = 0;
        if (!headerHidden && y > 160) setHeaderHidden(true);
      } else if (delta < -2) {
        upTravel -= delta;
        if (headerHidden && (upTravel > 50 || y < 160)) setHeaderHidden(false);
      }
      lastY = y;
    }
    syncTopbar();
  }, { passive: true });
  window.addEventListener('resize', syncTopbar);
  syncTopbar();

  /* ---------------- Live result count on the Apply button ----------------
     Any edit inside the drawer re-counts (debounced) using the PENDING
     selections, so the button reads "Show 12,405 Diamonds" before applying. */
  var applyBtnEl = document.getElementById('ds-apply');
  var panelEl = document.querySelector('.diamond-filter-panel');
  var countTimer = null;
  var countSeq = 0;

  function refreshApplyCount() {
    clearTimeout(countTimer);
    countTimer = setTimeout(function () {
      var params = buildQuery(true);
      params.set('limit', 1);
      var seq = ++countSeq;
      fetch(API_BASE + '/api/diamonds?' + params.toString())
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (seq !== countSeq) return;
          if (typeof data.total === 'number') {
            applyBtnEl.textContent = 'Show ' + data.total.toLocaleString() + ' Diamonds';
          }
        })
        .catch(function () { /* keep the current label */ });
    }, 350);
  }
  panelEl.addEventListener('click', function (e) {
    if (e.target.closest('.ds-chip, .diamond-shape-swatch, .diamond-toggle-pair button, .ds-btn--reset')) refreshApplyCount();
  });
  [caratMinEl, caratMaxEl, priceMinEl, priceMaxEl].forEach(function (el) {
    if (el) el.addEventListener('input', refreshApplyCount);
  });
  allFiltersBtnEl.addEventListener('click', refreshApplyCount);

  /* ---------------- Mobile: pin Reset/Apply to the drawer's bottom ----------------
     position:sticky needs a tall parent, so on small screens the actions move
     from the right column to the end of the panel (and back on desktop). */
  var actionsEl = document.querySelector('.ds-filter-actions');
  var actionsHomeEl = actionsEl.parentElement;
  var mq900 = window.matchMedia('(max-width: 900px)');
  function placeActions() {
    if (mq900.matches) panelEl.appendChild(actionsEl);
    else actionsHomeEl.appendChild(actionsEl);
  }
  if (mq900.addEventListener) mq900.addEventListener('change', placeActions);
  else if (mq900.addListener) mq900.addListener(placeActions);
  window.addEventListener('resize', placeActions); // some engines skip mq change events
  placeActions();

  /* ---------------- Applied-filter chips ----------------
     Rendered from the APPLIED state after every fresh search. Removing a chip
     clears that filter group and re-runs the search immediately - no Apply. */
  var activeChipsEl = document.getElementById('ds-active-chips');

  function chipDefs() {
    var defs = [];
    if (state.shapes.length) {
      defs.push({ key: 'shapes', label: 'Shape', value: state.shapes.map(titleCase).join(', ') });
    }
    if (state.colorTone === 'fancy') {
      var fv = [state.fancyIntensity, state.fancyColor, state.fancyOvertone].filter(Boolean).join(' ');
      defs.push({ key: 'fancy', label: 'Fancy colour', value: fv || 'Any' });
    } else if (state.color.length) {
      defs.push({ key: 'color', label: 'Colour', value: state.color.join(', ') });
    }
    if (state.clarity.length) defs.push({ key: 'clarity', label: 'Clarity', value: state.clarity.join(', ') });
    if (state.cut.length) defs.push({ key: 'cut', label: 'Cut', value: state.cut.join(', ') });
    if (state.polish.length) defs.push({ key: 'polish', label: 'Polish', value: state.polish.join(', ') });
    if (state.symmetry.length) defs.push({ key: 'symmetry', label: 'Symmetry', value: state.symmetry.join(', ') });
    if (state.eyeClean) defs.push({ key: 'eyeclean', label: 'Eye Clean', value: state.eyeClean });
    if (state.heartsArrows) defs.push({ key: 'hearts', label: 'Hearts & Arrows', value: 'Yes' });
    if (state.caratMin !== '' || state.caratMax !== '') {
      defs.push({ key: 'carat', label: 'Carat', value: (state.caratMin === '' ? '0' : state.caratMin) + ' – ' + (state.caratMax === '' ? 'max' : state.caratMax) + ' ct' });
    }
    if (state.priceMin !== '' || state.priceMax !== '') {
      var pMin = state.priceMin === '' ? '$0' : '$' + Number(state.priceMin).toLocaleString();
      var pMax = state.priceMax === '' ? 'max' : '$' + Number(state.priceMax).toLocaleString();
      defs.push({ key: 'price', label: 'Price', value: pMin + ' – ' + pMax });
    }
    return defs;
  }

  function renderChips() {
    var defs = chipDefs();
    allFiltersBtnEl.classList.toggle('has-filters', defs.length > 0);
    if (!defs.length) { activeChipsEl.hidden = true; activeChipsEl.innerHTML = ''; return; }
    activeChipsEl.hidden = false;
    activeChipsEl.innerHTML = defs.map(function (d) {
      return '<span class="ds-achip"><b>' + d.label + '</b> ' + d.value +
        ' <button type="button" data-clear="' + d.key + '" aria-label="Remove ' + d.label + ' filter">&times;</button></span>';
    }).join('') + '<button type="button" class="ds-clear-all" id="ds-clear-all">Clear all &times;</button>';
  }

  // Clears one group's state + drawer UI. Search is re-run by the caller.
  function resetGroupUI(key) {
    if (key === 'shapes') {
      state.shapes = [];
      document.querySelectorAll('.diamond-shape-row .diamond-shape-swatch.is-active').forEach(function (b) { b.classList.remove('is-active'); });
    } else if (key === 'color') {
      state.color = [];
      if (colorGridEl) colorGridEl.querySelectorAll('.ds-chip.is-active').forEach(function (b) { b.classList.remove('is-active'); });
    } else if (key === 'fancy') {
      state.colorTone = 'white';
      state.fancyColor = ''; state.fancyIntensity = ''; state.fancyOvertone = '';
      document.querySelectorAll('.diamond-toggle-pair button').forEach(function (b) {
        b.classList.toggle('is-active', b.getAttribute('data-tone') === 'white');
      });
      if (colorGridEl) colorGridEl.hidden = false;
      if (colorHintEl) colorHintEl.hidden = false;
      if (fancyFieldsEl) fancyFieldsEl.hidden = true;
      clearFancyChips();
    } else if (key === 'clarity') {
      state.clarity = [];
      document.querySelectorAll('#ds-clarity-row .ds-chip.is-active').forEach(function (b) { b.classList.remove('is-active'); });
    } else if (key === 'cut') {
      state.cut = [];
      document.querySelectorAll('#ds-cut-row .ds-chip.is-active').forEach(function (b) { b.classList.remove('is-active'); });
      clearCpsPresets();
    } else if (key === 'polish') {
      state.polish = [];
      document.querySelectorAll('#ds-polish-row .ds-chip.is-active').forEach(function (b) { b.classList.remove('is-active'); });
      clearCpsPresets();
    } else if (key === 'symmetry') {
      state.symmetry = [];
      document.querySelectorAll('#ds-symmetry-row .ds-chip.is-active').forEach(function (b) { b.classList.remove('is-active'); });
      clearCpsPresets();
    } else if (key === 'eyeclean') {
      state.eyeClean = '';
      document.querySelectorAll('#ds-eyeclean-row .ds-chip.is-active').forEach(function (b) { b.classList.remove('is-active'); });
    } else if (key === 'hearts') {
      state.heartsArrows = false;
      var haBtn = document.querySelector('#ds-cps-presets [data-preset="ha"]');
      if (haBtn) haBtn.classList.remove('is-active');
    } else if (key === 'carat') {
      state.caratMin = ''; state.caratMax = '';
      caratMinEl.value = ''; caratMaxEl.value = '';
      if (caratChipsEl) caratChipsEl.querySelectorAll('.ds-chip.is-active').forEach(function (b) { b.classList.remove('is-active'); });
    } else if (key === 'price') {
      state.priceMin = ''; state.priceMax = '';
      priceMinEl.value = ''; priceMaxEl.value = '';
    }
  }

  activeChipsEl.addEventListener('click', function (e) {
    var clearBtn = e.target.closest('[data-clear]');
    if (clearBtn) {
      resetGroupUI(clearBtn.getAttribute('data-clear'));
      runSearch(true);
      return;
    }
    if (e.target.closest('#ds-clear-all')) {
      ['shapes', 'fancy', 'color', 'clarity', 'cut', 'polish', 'symmetry', 'eyeclean', 'hearts', 'carat', 'price'].forEach(resetGroupUI);
      runSearch(true);
    }
  });

  sortEl.addEventListener('change', function () {
    // Option values are "<field>-<dir>": price | carat | ppc (price per carat).
    var parts = sortEl.value.split('-');
    state.sortBy = parts[0];
    state.direction = parts[1] === 'desc' ? 'DESC' : 'ASC';
    runSearch(true);
  });

  /* ---------------- Query + fetch ---------------- */
  // pending=true builds from what's currently EDITED in the drawer (carat and
  // price straight from the inputs) rather than the last-applied values - used
  // by the live count on the Apply button.
  function buildQuery(pending) {
    var params = new URLSearchParams();
    var caratMin = pending ? numOrBlank(caratMinEl.value) : state.caratMin;
    var caratMax = pending ? numOrBlank(caratMaxEl.value) : state.caratMax;
    var priceMin = pending ? numOrBlank(priceMinEl.value) : state.priceMin;
    var priceMax = pending ? numOrBlank(priceMaxEl.value) : state.priceMax;
    if (state.shapes.length) params.set('shapes', state.shapes.join(','));
    if (state.colorTone === 'fancy') {
      params.set('fancy', 'true');
      if (state.fancyColor) params.set('fancyColor', state.fancyColor);
      if (state.fancyIntensity) params.set('fancyIntensity', state.fancyIntensity);
      if (state.fancyOvertone) params.set('fancyOvertone', state.fancyOvertone);
    } else if (state.color.length) {
      params.set('color', state.color.join(','));
    }
    if (state.clarity.length) params.set('clarity', state.clarity.join(','));
    if (state.cut.length) params.set('cut', state.cut.join(','));
    if (state.polish.length) params.set('polish', state.polish.join(','));
    if (state.symmetry.length) params.set('symmetry', state.symmetry.join(','));
    if (state.eyeClean) params.set('eyeClean', state.eyeClean);
    if (state.heartsArrows) params.set('heartsArrows', 'true');
    params.set('labgrown', state.labgrown);
    if (caratMin !== '' && caratMin != null) params.set('caratMin', caratMin);
    if (caratMax !== '' && caratMax != null) params.set('caratMax', caratMax);
    if (priceMin !== '' && priceMin != null) params.set('priceMin', priceMin);
    if (priceMax !== '' && priceMax != null) params.set('priceMax', priceMax);
    params.set('sortBy', state.sortBy);
    params.set('sortDir', state.direction);
    params.set('limit', PAGE_SIZE);
    return params;
  }

  function skeletonHtml(n) {
    var out = '';
    for (var i = 0; i < n; i++) out += '<div class="diamond-card diamond-card--skeleton"></div>';
    return out;
  }

  function escapeAttr(s) {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function cardHtml(item) {
    var c = item.certificate || {};
    var img = item.image || 'https://placehold.co/400x400?text=No+Image';
    var video = item.video || '';
    var title = (c.carats || '?') + 'ct ' + titleCase(c.shape || '');
    var price = item.price_usd != null ? '$' + item.price_usd.toLocaleString() : 'Price on request';
    return '' +
      '<div class="diamond-card" data-id="' + encodeURIComponent(item.id) + '">' +
        '<div class="diamond-card__image-wrap"' + (video ? ' data-video="' + escapeAttr(video) + '"' : '') + '>' +
          (c.lab ? '<span class="diamond-card__lab-badge">' + c.lab + '</span>' : '') +
          '<img src="' + img + '" alt="' + title + '" loading="lazy">' +
          (video ? '<button type="button" class="ds-360-badge" aria-label="View 360 spin">360&deg;</button>' : '') +
        '</div>' +
        '<div class="diamond-card__body">' +
          '<h3 class="diamond-card__title">' + title + '</h3>' +
          '<p class="diamond-card__specs">Color <span>' + (c.color || '-') + '</span> &middot; Clarity <span>' + (c.clarity || '-') + '</span> &middot; Cut <span>' + (c.cut || '-') + '</span></p>' +
          '<div class="diamond-card__price">' + price + (item.price_usd != null ? ' <sup>USD</sup>' : '') + '</div>' +
        '</div>' +
      '</div>';
  }

  function titleCase(s) {
    if (!s) return '';
    return s.charAt(0).toUpperCase() + s.slice(1).toLowerCase();
  }

  function runSearch(reset) {
    if (reset) { state.offset = 0; renderChips(); }
    var params = buildQuery();
    params.set('offset', state.offset);
    var qs = params.toString();
    lastQueryString = qs;

    if (reset) {
      gridEl.innerHTML = skeletonHtml(8);
      countEl.textContent = 'Loading diamonds' + String.fromCharCode(8230);
    }
    loadMoreEl.hidden = true;

    fetch(API_BASE + '/api/diamonds?' + qs)
      .then(function (res) {
        if (!res.ok) throw new Error('Search failed (' + res.status + ')');
        return res.json();
      })
      .then(function (data) {
        if (qs !== lastQueryString) return;
        var items = data.items || [];
        var pageCount = items.length;
        state.total = data.total || 0;
        // The worker returns the true match count (diamonds_by_query_count),
        // which exceeds one page. If that count call ever fails it falls back to
        // the page length, so also treat "got a full page" as "there may be more".
        var totalKnown = state.total > PAGE_SIZE;

        if (reset) gridEl.innerHTML = '';
        if (pageCount === 0 && state.offset === 0) {
          gridEl.innerHTML = '<div class="diamond-grid-empty">No diamonds match those filters. Try widening your search.</div>';
          countEl.textContent = '0 diamonds';
          return;
        }
        items.forEach(function (item) {
          itemsById[item.id] = item;
          gridEl.insertAdjacentHTML('beforeend', cardHtml(item));
        });
        state.offset += pageCount;
        var hasMore = totalKnown ? (state.offset < state.total) : (pageCount === PAGE_SIZE);
        loadMoreEl.hidden = !hasMore;
        countEl.textContent = totalKnown
          ? ('Results ' + String.fromCharCode(8212) + ' ' + state.total.toLocaleString() + ' Diamonds')
          : ('Showing ' + state.offset.toLocaleString() + (hasMore ? '+' : '') + ' Diamonds');
      })
      .catch(function (err) {
        gridEl.innerHTML = '<div class="diamond-grid-empty">Something went wrong loading diamonds. Please try again.</div>';
        countEl.textContent = '';
        console.error(err);
      });
  }

  gridEl.addEventListener('click', function (e) {
    var card = e.target.closest('.diamond-card');
    if (!card) return;
    var id = decodeURIComponent(card.getAttribute('data-id'));
    // 360 is click-to-load: the badge opens the popup on the spin, the rest of
    // the image opens it on the photo, and the body opens the detail view. The
    // loupe360 iframe only ever loads when a shopper deliberately asks for 360.
    if (e.target.closest('.ds-360-badge')) {
      openMediaPopup(id, 'video');
    } else if (e.target.closest('.diamond-card__image-wrap')) {
      openMediaPopup(id, 'image');
    } else {
      showDetail(id);
    }
  });

  /* ---------------- 360 spin viewer (click-to-load, shared mount) ---------------- */
  function mountViewer(wrap, url) {
    if (!wrap || wrap.querySelector('.ds-viewer')) return;
    var f = document.createElement('iframe');
    f.className = 'ds-viewer';
    // The loupe360 player is NOT responsive: it renders at exactly the size
    // requested in the URL path (default /video/500/500). Request the wrap's
    // own size so the player fits the card natively — this also downloads
    // smaller, faster frames. Fall back to scaling a 500px player down if
    // the URL doesn't have the expected /video/W/H shape.
    var w = Math.round(wrap.clientWidth);
    if (w && w < 500) {
      var sized = url.replace(/\/video\/\d+\/\d+/, '/video/' + w + '/' + w);
      if (sized !== url) {
        url = sized;
      } else {
        f.style.width = '500px';
        f.style.height = '500px';
        f.style.transformOrigin = '0 0';
        f.style.transform = 'scale(' + (w / 500) + ')';
      }
    }
    f.src = url;
    f.setAttribute('frameborder', '0');
    f.setAttribute('scrolling', 'no');
    f.setAttribute('allow', 'autoplay; fullscreen');
    f.setAttribute('allowfullscreen', '');
    f.setAttribute('referrerpolicy', 'no-referrer-when-downgrade');
    wrap.classList.add('is-playing');
    wrap.appendChild(f);
  }

  function unmountViewer(wrap) {
    if (!wrap) return;
    var f = wrap.querySelector('.ds-viewer');
    if (f) f.remove();
    wrap.classList.remove('is-playing');
  }

  /* Hover-to-spin on grid cards (hover-capable devices only). The loupe360
     iframe mounts after a short dwell and then STAYS mounted, so a re-hover
     is instant and the shopper can click-drag the spin or use the player's
     slide arrows. Only the most recent few stay alive — the iframes are
     heavy, so older ones are unmounted (their static image returns). */
  if (window.matchMedia && window.matchMedia('(hover: hover)').matches) {
    var hoverWrap = null;
    var hoverTimer = null;
    var mountedWraps = [];
    gridEl.addEventListener('mouseover', function (e) {
      var wrap = e.target.closest('.diamond-card__image-wrap');
      if (!wrap || wrap === hoverWrap) return;
      clearTimeout(hoverTimer);
      hoverWrap = wrap;
      var url = wrap.getAttribute('data-video');
      if (!url || wrap.querySelector('.ds-viewer')) return;
      hoverTimer = setTimeout(function () {
        mountViewer(wrap, url);
        mountedWraps.push(wrap);
        while (mountedWraps.length > 6) unmountViewer(mountedWraps.shift());
      }, 200);
    });
    gridEl.addEventListener('mouseout', function (e) {
      var wrap = e.target.closest('.diamond-card__image-wrap');
      if (!wrap) return;
      if (e.relatedTarget && wrap.contains(e.relatedTarget)) return;
      clearTimeout(hoverTimer);
      hoverTimer = null;
      if (hoverWrap === wrap) hoverWrap = null;
    });
  }

  /* ---------------- Media popup (lightbox) ---------------- */
  var lightboxEl = document.getElementById('ds-lightbox');
  var lbTitleEl = document.getElementById('ds-lightbox-title');
  var lbMediaEl = document.getElementById('ds-lightbox-media');
  var lbSpecsEl = document.getElementById('ds-lightbox-specs');
  var lbThumbsEl = document.getElementById('ds-lightbox-thumbs');
  var lbCtaEl = document.getElementById('ds-lightbox-cta');
  var lbCurrentId = null;

  function openMediaPopup(id, initialView) {
    var item = itemsById[id];
    if (!item) { showDetail(id); return; } // no cached item -> fall straight to detail
    lbCurrentId = id;
    var c = item.certificate || {};
    lbTitleEl.textContent =
      (c.carats || '?') + 'ct ' + titleCase(c.shape || '') + ' ' +
      [c.color, c.clarity, c.cut].filter(Boolean).join(' ');

    // Price + quick spec summary, so the popup answers most questions before
    // the shopper ever needs the full detail page.
    if (lbSpecsEl) {
      var m = c.measurements || {};
      var dims = [m.length, m.width, m.depth].filter(Boolean).join(' × ');
      var facts = [
        ['Colour', c.color], ['Clarity', c.clarity],
        ['Cut', c.cut], ['Polish', c.polish],
        ['Symmetry', c.symmetry], ['Fluorescence', c.fluorescence],
        ['Lab', c.lab], ['Certificate', c.number],
        ['Measurements', dims || null], ['Eye Clean', item.eye_clean],
        ['Table %', c.table_pct], ['Depth %', c.depth_pct],
      ].filter(function (f) { return f[1]; });
      lbSpecsEl.innerHTML =
        '<div class="ds-lb-price">' +
          (item.price_usd != null ? '$' + item.price_usd.toLocaleString() + '<sup>USD</sup>' : 'Price on request') +
        '</div>' +
        '<div class="ds-lb-grid">' +
          facts.map(function (f) {
            return '<div><span>' + f[0] + '</span><span>' + f[1] + '</span></div>';
          }).join('') +
        '</div>';
    }

    // Build the thumbnail row: 360 spin first (if any), then the front-view image.
    var thumbs = [];
    if (item.video) thumbs.push({ view: 'video', label: '360' + String.fromCharCode(176) + ' Video', bg: item.image });
    if (item.image) thumbs.push({ view: 'image', label: 'Front view', bg: item.image });
    lbThumbsEl.innerHTML = thumbs.map(function (t) {
      return '<button type="button" class="ds-thumb" data-view="' + t.view + '">' +
        '<span class="ds-thumb__img" style="background-image:url(\'' + (t.bg || '') + '\')"></span>' +
        t.label + '</button>';
    }).join('');
    lbThumbsEl.hidden = thumbs.length < 2;

    showPopupView(initialView === 'video' && item.video ? 'video' : 'image', item);
    lightboxEl.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function showPopupView(view, item) {
    if (view === 'video' && item.video) {
      lbMediaEl.innerHTML =
        '<iframe src="' + item.video + '" frameborder="0" allow="autoplay; fullscreen" ' +
        'allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe>';
    } else {
      lbMediaEl.innerHTML = '<img src="' + (item.image || 'https://placehold.co/600x600?text=No+Image') + '" alt="">';
    }
    Array.prototype.forEach.call(lbThumbsEl.querySelectorAll('.ds-thumb'), function (b) {
      b.classList.toggle('is-active', b.getAttribute('data-view') === view);
    });
  }

  function closeMediaPopup() {
    lightboxEl.hidden = true;
    lbMediaEl.innerHTML = ''; // stop the iframe
    document.body.style.overflow = '';
    lbCurrentId = null;
  }

  lbThumbsEl.addEventListener('click', function (e) {
    var t = e.target.closest('.ds-thumb');
    if (!t || !lbCurrentId) return;
    showPopupView(t.getAttribute('data-view'), itemsById[lbCurrentId]);
  });

  lbCtaEl.addEventListener('click', function () {
    var id = lbCurrentId;
    closeMediaPopup();
    if (id) showDetail(id);
  });

  lightboxEl.addEventListener('click', function (e) {
    if (e.target.hasAttribute('data-ds-close')) closeMediaPopup();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !lightboxEl.hidden) closeMediaPopup();
  });

  loadMoreEl.addEventListener('click', function () { runSearch(false); });

  /* ---------------- Detail view (unchanged) ---------------- */
  function showDetail(id) {
    history.pushState({ diamond: id }, '', '?diamond=' + encodeURIComponent(id));
    renderDetail(id);
  }

  function renderDetail(id) {
    listingEl.hidden = true;
    detailEl.hidden = false;
    window.scrollTo(0, 0);

    document.getElementById('ds-detail-title').textContent = 'Loading' + String.fromCharCode(8230);
    document.getElementById('ds-detail-specs').innerHTML = '';
    document.getElementById('ds-detail-price').textContent = '';
    document.getElementById('ds-detail-lab').textContent = '';
    document.getElementById('ds-detail-image').src = '';
    var dWrapReset = detailEl.querySelector('.diamond-card__image-wrap');
    unmountViewer(dWrapReset);
    var oldBtn = dWrapReset.querySelector('.ds-360-detail-btn');
    if (oldBtn) oldBtn.remove();

    fetch(API_BASE + '/api/diamonds/' + encodeURIComponent(id))
      .then(function (res) {
        if (!res.ok) throw new Error('Lookup failed (' + res.status + ')');
        return res.json();
      })
      .then(function (item) {
        var c = item.certificate || {};
        document.getElementById('ds-detail-lab').textContent = c.lab ? c.lab + ' Certified' : 'Certified Diamond';
        document.getElementById('ds-detail-title').textContent = (c.carats || '?') + 'ct ' + titleCase(c.shape || '');
        document.getElementById('ds-detail-image').src = item.image || 'https://placehold.co/600x600?text=No+Image';
        if (item.video) {
          var dWrap = detailEl.querySelector('.diamond-card__image-wrap');
          var btn360 = document.createElement('button');
          btn360.type = 'button';
          btn360.className = 'ds-360-badge ds-360-detail-btn';
          btn360.innerHTML = 'View in 360' + String.fromCharCode(176);
          btn360.addEventListener('click', function () {
            mountViewer(dWrap, item.video); // loupe360 iframe loads only on this click
            btn360.remove();
          });
          dWrap.appendChild(btn360);
        }
        document.getElementById('ds-detail-price').innerHTML = (item.price_usd != null ? '$' + item.price_usd.toLocaleString() + ' <sup>USD</sup>' : 'Price on request');

        var rows = [
          ['Shape', titleCase(c.shape)],
          ['Carat', c.carats],
          ['Color', c.color],
          ['Clarity', c.clarity],
          ['Cut', c.cut],
          ['Polish', c.polish],
          ['Symmetry', c.symmetry],
          ['Fluorescence', c.fluorescence],
          ['Lab', c.lab],
          ['Certificate #', c.number],
          ['Measurements', c.measurements ? [c.measurements.length, c.measurements.width, c.measurements.depth].filter(Boolean).join(' x ') : null],
          ['Table %', c.table_pct],
          ['Depth %', c.depth_pct],
        ];
        document.getElementById('ds-detail-specs').innerHTML = rows
          .filter(function (r) { return r[1]; })
          .map(function (r) { return '<tr><td>' + r[0] + '</td><td>' + r[1] + '</td></tr>'; })
          .join('');
      })
      .catch(function (err) {
        document.getElementById('ds-detail-title').textContent = 'Diamond not found';
        console.error(err);
      });
  }

  document.getElementById('ds-back-link').addEventListener('click', function (e) {
    e.preventDefault();
    history.pushState({}, '', location.pathname);
    showListing();
  });

  function showListing() {
    detailEl.hidden = true;
    listingEl.hidden = false;
  }

  window.addEventListener('popstate', function () {
    var params = new URLSearchParams(location.search);
    var id = params.get('diamond');
    if (id) renderDetail(id);
    else showListing();
  });

  /* ---------------- Init ---------------- */
  if (fancyFieldsEl) fancyFieldsEl.hidden = true; // colour grid is the default view
  initializing = false;

  var initialParams = new URLSearchParams(location.search);
  var initialDiamond = initialParams.get('diamond');
  if (initialDiamond) {
    renderDetail(initialDiamond);
  } else {
    runSearch(true);
  }
})();
</script>


{% endraw %}
{% schema %}
{ "name": "Nivoda Diamond Search", "settings": [] }
{% endschema %}