  color: var(--orloff-text-muted);
  margin-bottom: 8px;
}
.ds-chip--fancy {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}
.ds-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
  border: 1px solid rgba(9, 27, 54, 0.18);
  flex: 0 0 auto;
}
/* Keep the dot visible when the chip goes navy */
.ds-chip--fancy.is-active .ds-dot { border-color: rgba(255, 255, 255, 0.6); }
/* The explicit display on the grid/fields overrides the [hidden] attribute's
   display:none, so restore it — this is what makes White/Fancy actually swap. */
.ds-color-grid[hidden],
.ds-fancy-fields[hidden] { display: none; }
.ds-minmax {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}
.ds-minmax input {
  width: 100px;
  font-family: var(--font-body);
  font-size: 13px;
  padding: 10px 12px;
  border: 1px solid var(--orloff-border);
  border-radius: 0;
  color: var(--orloff-navy);
  /* The theme forces a tall fixed height on inputs, which top-aligns the
     text; restore normal metrics so "$ Min" sits centered. */
  padding: 10px 12px !important;
  height: auto !important;
  min-height: 0 !important;
  line-height: 1.4 !important;
  box-sizing: border-box;
  background: #fff;
