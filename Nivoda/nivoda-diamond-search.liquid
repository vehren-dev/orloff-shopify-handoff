{% raw %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
/* ==========================================================================
   ORLOFF OF DENMARK — Diamond Search / Listing Page
   Brand system: navy #091b36, gold #bc973f accent
   Headings: Cormorant Garamond | Body: Inter
   ========================================================================== */

:root {
  --orloff-navy: #091b36;
  --orloff-gold: #bc973f;
  --orloff-white: #ffffff;
  --orloff-off-white: #faf9f7;
  --orloff-border: #d8d3ca;
  --orloff-text-muted: #6b7280;
  --font-heading: 'Cormorant Garamond', serif;
  --font-body: 'Inter', sans-serif;
}

.orloff-eyebrow {
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--orloff-gold);
  margin-bottom: 8px;
  display: block;
}

.diamond-page-header {
  text-align: center;
  padding: 104px 24px 88px;
  position: relative;
  /* Full-bleed banner with the brand diamond image; dark overlay guarantees
     the light text stays readable regardless of the photo. */
  width: 100vw;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  background:
    linear-gradient(rgba(9, 27, 54, 0.55), rgba(9, 27, 54, 0.64)),
    url('https://cdn.shopify.com/s/files/1/0852/4428/1122/files/DIAMONDS_NEW_IMAGE.png?v=1771413250') center/cover no-repeat;
}

.diamond-page-header__title {
  font-family: var(--font-heading);
  font-weight: 500;
  font-size: 46px;
  color: var(--orloff-white);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin: 0 0 12px;
}

.diamond-page-header p {
  font-family: var(--font-body);
  font-size: 15px;
  color: rgba(255, 255, 255, 0.85);
  max-width: 520px;
  margin: 0 auto;
  line-height: 1.6;
}

/* --------------------------------------------------------------------
   Filter drawer — hidden by default, slides down smoothly from the top
   of the viewport when "All filters" is clicked.
   -------------------------------------------------------------------- */
.ds-drawer-backdrop {
  position: fixed;
  inset: 0;
  /* Above the theme header (which has its own stacking context) */
  z-index: 9995;
  background: rgba(9, 27, 54, 0.35);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.ds-drawer-backdrop.is-open { opacity: 1; pointer-events: auto; }

.ds-drawer {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  z-index: 9996;
  width: min(920px, 100vw);
  background: var(--orloff-white);
  overflow-y: auto;
  transform: translateX(-103%);
  transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1);
  box-shadow: 18px 0 48px rgba(9, 27, 54, 0.18);
}
.ds-drawer.is-open { transform: translateX(0); }

.ds-drawer__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 36px 0;
  box-sizing: border-box;
  font-family: var(--font-heading);
  font-size: 20px;
  color: var(--orloff-navy);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.ds-drawer__close {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 26px;
  line-height: 1;
  color: var(--orloff-navy);
  padding: 4px 8px;
}

.diamond-filter-panel {
  padding: 18px 36px 36px;
  box-sizing: border-box;
  font-family: var(--font-body);
}

@media (max-width: 900px) {
  .diamond-filter-panel { padding: 20px 20px 32px; }
  .ds-drawer__head { padding: 16px 20px 0; }
}

.diamond-source-tabs {
  display: flex;
  gap: 40px;
  justify-content: center;
  margin-bottom: 32px;
}

.diamond-source-tab {
  font-family: var(--font-heading);
  font-size: 22px;
  color: var(--orloff-text-muted);
  background: none;
  border: none;
  padding-bottom: 8px;
  cursor: pointer;
  border-bottom: 2px solid transparent;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.diamond-source-tab.is-active {
  color: var(--orloff-navy);
  border-bottom-color: var(--orloff-navy);
}

.diamond-filter-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28px 44px;
}

@media (max-width: 900px) {
  .diamond-filter-grid { grid-template-columns: 1fr; gap: 24px; }
}

/* The divider sits directly ABOVE each section title (tight, 14px), so the
   line + title read as one unit. First block per column has no line. */
.diamond-filter-block {
  border-top: 1px solid var(--orloff-border);
  padding-top: 14px;
}

.diamond-filter-block:first-child {
  border-top: none;
  padding-top: 0;
}

.diamond-filter-block__label {
  font-family: var(--font-heading);
  font-size: 17px;
  color: var(--orloff-navy);
  margin-bottom: 14px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.diamond-shape-row {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12px;
}

.diamond-shape-swatch {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  width: auto;
  padding: 12px 6px;
  border: 1px solid var(--orloff-border);
  border-radius: 0;
  background: #fff;
  cursor: pointer;
  font-family: var(--font-body);
  font-size: 11.5px;
  color: var(--orloff-navy);
  transition: border-color 0.15s ease;
}

.diamond-shape-swatch .ds-shape-img {
  width: 48px;
  height: 48px;
  object-fit: contain;
}

.diamond-shape-swatch:hover,
.diamond-shape-swatch.is-active { border-color: var(--orloff-navy); border-width: 1.5px; }

.diamond-toggle-pair {
  display: inline-flex;
  border: 1px solid var(--orloff-border);
  border-radius: 0;
  overflow: hidden;
}

.diamond-toggle-pair button {
  font-family: var(--font-body);
  font-size: 13px;
  padding: 10px 22px;
  border: none;
  background: #fff;
  color: var(--orloff-navy);
  cursor: pointer;
  text-transform: none;
  letter-spacing: normal;
}

.diamond-toggle-pair button.is-active {
  background: var(--orloff-navy);
  color: #fff;
}

/* ---------------- Dual-handle range slider ---------------- */
.orloff-range {
  position: relative;
  height: 20px;
  margin: 12px 0 10px;
}

.orloff-range__track {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--orloff-border);
  transform: translateY(-50%);
  border-radius: 0;
}

.orloff-range__fill {
  position: absolute;
  top: 50%;
  height: 3px;
  background: var(--orloff-navy);
  transform: translateY(-50%);
  border-radius: 0;
}

.orloff-range input[type="range"] {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 20px;
  margin: 0;
  background: none;
  -webkit-appearance: none;
  appearance: none;
  pointer-events: none;
}

.orloff-range input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  pointer-events: all;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #fff;
  border: 1.5px solid var(--orloff-navy);
  box-shadow: 0 1px 3px rgba(9, 27, 54, 0.25);
  cursor: grab;
}

.orloff-range input[type="range"]::-moz-range-thumb {
  pointer-events: all;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #fff;
  border: 1.5px solid var(--orloff-navy);
  box-shadow: 0 1px 3px rgba(9, 27, 54, 0.25);
  cursor: grab;
  box-sizing: border-box;
}

.orloff-range__ticks {
  display: flex;
  justify-content: space-between;
  font-family: var(--font-body);
  font-size: 15px;
  color: var(--orloff-navy);
  margin-top: 6px;
}

.orloff-range__inputs {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 14px;
}

.orloff-range__inputs input[type="text"],
.orloff-range__inputs input[type="number"] {
  width: 90px;
  font-family: var(--font-body);
  font-size: 13px;
  padding: 10px 12px;
  border: 1px solid var(--orloff-border);
  border-radius: 0;
  color: var(--orloff-navy);
}

.orloff-range__inputs span.unit {
  font-size: 13px;
  color: var(--orloff-text-muted);
}

.orloff-range__inputs span.sep {
  color: var(--orloff-text-muted);
}

.diamond-advanced-toggle {
  margin-top: 24px;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 13px;
  color: var(--orloff-navy);
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
}

/* --------------------------------------------------------------------
   Result grid + cards
   -------------------------------------------------------------------- */
/* Thin sticky bar: All filters button + Natural/Lab tabs + count + sort.
   Shopify themes wrap content in overflow containers that break
   position: sticky, so the bar is pinned by JS (.is-stuck) instead. */
.ds-topbar {
  position: relative;
  z-index: 40;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14px 20px;
  width: 100vw;
  margin-left: calc(50% - 50vw);
  padding: 10px 24px;
  box-sizing: border-box;
  background: var(--orloff-white);
  border-bottom: 1px solid var(--orloff-border);
  font-family: var(--font-body);
  font-size: 13px;
  color: var(--orloff-text-muted);
}

/* Pinned to the viewport by JS once scrolled past; top is set inline to sit
   flush under however much of the theme header is currently visible. */
.ds-topbar.is-stuck {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  margin-left: 0;
  z-index: 800;
  box-shadow: 0 2px 12px rgba(9, 27, 54, 0.06);
  /* Glides between the top edge and the header's lower edge as the header
     fades out/in. Safe to keep on: while stuck, top only changes on fades. */
  transition: top 0.3s ease;
}

.ds-allfilters-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 500;
  color: var(--orloff-navy);
  background: #fff;
  border: 1px solid var(--orloff-border);
  border-radius: 0;
  padding: 9px 16px;
  cursor: pointer;
  transition: border-color 0.15s ease;
}
.ds-allfilters-btn:hover { border-color: var(--orloff-navy); }
.ds-allfilters-btn svg { display: block; }

/* Gold dot on the button whenever any filter is applied */
.ds-filter-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--orloff-gold);
  display: none;
}
.ds-allfilters-btn.has-filters .ds-filter-dot { display: inline-block; }

.ds-topbar__count { margin-left: auto; }

/* Sort dropdown, restyled to the brand (native look removed, custom chevron).
   height/line-height are pinned with !important because the theme forces tall
   fixed input metrics that top-align the text otherwise. */
.ds-topbar select {
  font-family: var(--font-body);
  font-size: 13px;
  letter-spacing: 0.02em;
  color: var(--orloff-navy);
  background-color: var(--orloff-white);
  border: 1px solid var(--orloff-border);
  border-radius: 0;
  padding: 8px 32px 8px 12px !important;
  height: auto !important;
  min-height: 0 !important;
  line-height: 1.4 !important;
  box-sizing: border-box;
  cursor: pointer;
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path d='M1 1l4 4 4-4' fill='none' stroke='%23091b36' stroke-width='1.5' stroke-linecap='round'/></svg>");
  background-repeat: no-repeat;
  background-position: right 12px center;
  transition: border-color 0.15s ease;
}
.ds-topbar select:hover { border-color: var(--orloff-navy); }
.ds-topbar select option { font-family: var(--font-body); color: var(--orloff-navy); }

/* Tabs are compact inside the bar (they were large + centered in the old panel) */
.ds-topbar .diamond-source-tabs {
  margin-bottom: 0;
  gap: 22px;
  justify-content: flex-start;
}
.ds-topbar .diamond-source-tab {
  font-size: 15px;
  padding-bottom: 4px;
}

/* Applied-filter chips row: always visible under the bar; removing a chip
   re-runs the search immediately (no Apply needed). */
.ds-active-chips {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  width: 100vw;
  margin-left: calc(50% - 50vw);
  padding: 10px 24px;
  box-sizing: border-box;
  background: var(--orloff-off-white);
  font-family: var(--font-body);
  font-size: 12.5px;
}
.ds-active-chips[hidden] { display: none; }

.ds-achip {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: #fff;
  border: 1px solid var(--orloff-border);
  border-radius: 0;
  padding: 6px 10px;
  color: var(--orloff-navy);
}
.ds-achip b { font-weight: 600; }
.ds-achip button {
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  font-size: 15px;
  line-height: 1;
  color: var(--orloff-text-muted);
}
.ds-achip button:hover { color: var(--orloff-navy); }

.ds-clear-all {
  background: none;
  border: none;
  cursor: pointer;
  font-family: var(--font-body);
  font-size: 12.5px;
  font-weight: 500;
  color: var(--orloff-navy);
  text-decoration: underline;
  padding: 6px 4px;
}

.diamond-grid {
  display: grid;
  /* 5 larger cards per row on desktop, stepping down on smaller screens */
  grid-template-columns: repeat(5, 1fr);
  gap: 24px;
  /* Full-bleed: feed spreads edge-to-edge on every device. Cards keep their own
     internal padding, so diamond images still have breathing room. */
  width: 100vw;
  position: relative;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  padding: 24px 48px 96px;
  box-sizing: border-box;
}

@media (max-width: 1200px) {
  .diamond-grid { grid-template-columns: repeat(4, 1fr); }
}

@media (max-width: 900px) {
  .diamond-grid { grid-template-columns: repeat(3, 1fr); gap: 16px; padding: 16px 16px 64px; }
}

@media (max-width: 600px) {
  .diamond-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
}

.diamond-card {
  background: var(--orloff-white);
  border: 1px solid var(--orloff-border);
  border-radius: 0;
  overflow: hidden;
  cursor: pointer;
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}

.diamond-card:hover {
  box-shadow: 0 8px 24px rgba(9, 27, 54, 0.08);
  transform: translateY(-2px);
}

.diamond-card__image-wrap {
  position: relative;
  aspect-ratio: 1 / 1;
  background: var(--orloff-off-white);
  overflow: hidden;
}

.diamond-card__image-wrap img,
.diamond-card__image-wrap video {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 14px;
  box-sizing: border-box;
}

.diamond-card__lab-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  font-family: var(--font-body);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 3px 7px;
  border-radius: 0;
  background: var(--orloff-navy);
  color: var(--orloff-white);
}

.diamond-card__body {
  padding: 12px 14px 16px;
}

.diamond-card__title {
  font-family: var(--font-body);
  font-size: 17px;
  font-weight: 500;
  color: var(--orloff-navy);
  margin: 0 0 3px;
}

.diamond-card__specs {
  font-family: var(--font-body);
  font-size: 11.5px;
  color: var(--orloff-text-muted);
  margin: 0 0 10px;
  letter-spacing: 0.01em;
}

.diamond-card__specs span {
  color: var(--orloff-navy);
}

.diamond-card__price {
  font-family: var(--font-body);
  font-size: 20px;
  font-weight: 600;
  color: var(--orloff-navy);
  letter-spacing: 0.01em;
}

.diamond-card__price sup {
  font-family: var(--font-body);
  font-size: 10px;
  font-weight: 500;
  color: var(--orloff-text-muted);
  margin-left: 3px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.diamond-grid-empty {
  grid-column: 1 / -1;
  text-align: center;
  padding: 80px 24px;
  font-family: var(--font-body);
  color: var(--orloff-text-muted);
  font-size: 14px;
}

.diamond-card--skeleton {
  background: linear-gradient(90deg, var(--orloff-off-white) 0%, #f0ede8 50%, var(--orloff-off-white) 100%);
  background-size: 200% 100%;
  animation: orloff-shimmer 1.4s ease-in-out infinite;
  aspect-ratio: 3 / 4;
}

@keyframes orloff-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* --------------------------------------------------------------------
   Diamond detail view (single stone) — unchanged from prior build
   -------------------------------------------------------------------- */
.diamond-detail {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 56px 24px 96px;
}

@media (max-width: 900px) {
  .diamond-detail {
    grid-template-columns: 1fr;
    gap: 32px;
  }
}

.diamond-detail__price {
  font-family: var(--font-body);
  font-size: 38px;
  font-weight: 600;
  color: var(--orloff-navy);
  margin: 4px 0 24px;
}

.diamond-detail__price sup {
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 500;
  color: var(--orloff-text-muted);
  margin-left: 6px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.diamond-detail__specs-table {
  width: 100%;
  border-collapse: collapse;
  font-family: var(--font-body);
  font-size: 13.5px;
}

.diamond-detail__specs-table tr {
  border-bottom: 1px solid var(--orloff-border);
}

.diamond-detail__specs-table td {
  padding: 12px 0;
}

.diamond-detail__specs-table td:first-child {
  color: var(--orloff-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-size: 11px;
  font-weight: 600;
  width: 40%;
}

.diamond-detail__specs-table td:last-child {
  color: var(--orloff-navy);
  font-weight: 500;
  text-align: right;
}

.diamond-detail__cta {
  display: inline-block;
  width: 100%;
  text-align: center;
  padding: 16px 24px;
  margin-top: 24px;
  background: var(--orloff-navy);
  color: var(--orloff-white);
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border: none;
  border-radius: 0;
  cursor: pointer;
  transition: background 0.2s ease;
}

.diamond-detail__cta:hover {
  background: #0d2547;
}

.diamond-detail__cta:disabled {
  background: var(--orloff-border);
  color: var(--orloff-text-muted);
  cursor: not-allowed;
}

/* -- Supplementary rules for structure not covered above -- */
.ds-back-link {
  display: inline-block;
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 500;
  color: var(--orloff-navy);
  text-decoration: none;
  margin-bottom: 16px;
}
.ds-back-link:hover { color: var(--orloff-gold); }
.diamond-detail__media .diamond-card__image-wrap { max-width: 100%; }

/* -- 360 spin viewer (Nivoda video URL, embedded as an iframe) -- */
.diamond-card__body { cursor: pointer; }
.diamond-card__image-wrap .ds-viewer {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
  padding: 0;
  z-index: 2;
  background: var(--orloff-off-white);
}
/* On grid cards the hover viewer is INTERACTIVE: loupe360's own player
   provides click-drag rotation and its two slides (360 spin / front photo,
   via the arrows) directly on the card. Clicking the spin therefore belongs
   to the player, not the popup — the card body still opens the detail view. */
#diamond-grid .diamond-card__image-wrap { cursor: pointer; }
#diamond-grid .diamond-card__image-wrap.is-playing { cursor: grab; }
#ds-detail .diamond-card__image-wrap.is-playing { cursor: grab; }

/* Small "360°" affordance badge on cards that have a video */
.ds-360-badge {
  position: absolute;
  bottom: 10px;
  left: 10px;
  z-index: 3;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-family: var(--font-body);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.06em;
  padding: 5px 11px;
  border: 0;
  border-radius: 999px;
  background: rgba(9, 27, 54, 0.82);
  color: var(--orloff-white);
  cursor: pointer;
}
.ds-360-badge:hover { background: var(--orloff-navy); }
/* Detail-view 360 button: centered, a touch larger */
.ds-360-detail-btn {
  bottom: 14px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 12px;
  padding: 9px 18px;
}
.diamond-card__image-wrap.is-playing .ds-360-badge { display: none; }

/* -- Media popup (lightbox), theme-matched -- */
.ds-lightbox {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
