{% render 'og-styles' %}

{%- assign og_contacts = section.blocks | where: 'type', 'contact' -%}

<div class="og-section">
  <div class="og-on-navy">
    <div class="og-wrap {% if section.settings.compact %}og-pad-tight{% else %}og-pad{% endif %} og-cta">
      <div class="og-cta__grid{% if og_contacts.size > 0 %} og-cta__grid--split{% endif %}">

        <div class="og-cta__text">
          {% render 'og-label', text: section.settings.label, on_navy: true %}

          {%- if section.settings.heading != blank -%}
            <h2 class="{% if section.settings.compact %}og-h2{% else %}og-claim{% endif %}">{{ section.settings.heading }}</h2>
          {%- endif -%}

          {%- if section.settings.body != blank -%}
            <div class="og-body">{{ section.settings.body }}</div>
          {%- endif -%}

          {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
            <div class="og-btns">
              {% render 'og-button', label: section.settings.button_1_label, href: section.settings.button_1_link, style: section.settings.button_1_style %}
              {% render 'og-button', label: section.settings.button_2_label, href: section.settings.button_2_link, style: 'secondary' %}
            </div>
          {%- endif -%}

          {%- if section.settings.footnote != blank -%}
            <div class="og-note" style="margin-top:1.5rem">{{ section.settings.footnote }}</div>
          {%- endif -%}
        </div>

        {%- if og_contacts.size > 0 -%}
          <div class="og-contacts">
            {%- for block in og_contacts -%}
              <address class="og-contact" style="font-style:normal" {{ block.shopify_attributes }}>
                {%- if block.settings.name != blank -%}
                  <span class="og-contact__name">{{ block.settings.name }}</span>
                {%- endif -%}
                {%- if block.settings.role != blank -%}
                  <span class="og-contact__role">{{ block.settings.role }}</span>
                {%- endif -%}
                {%- if block.settings.email != blank -%}
                  <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                {%- endif -%}
                {%- if block.settings.phone != blank -%}
                  <a href="tel:{{ block.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ block.settings.phone }}</a>
                {%- endif -%}
              </address>
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Orloff | Navy CTA",
  "tag": "section",
  "class": "og-shopify-section",
  "max_blocks": 3,
  "settings": [
    { "type": "checkbox", "id": "compact", "label": "Compact banner", "default": false },
    { "type": "text", "id": "label", "label": "Section label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body" },

    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_1_label", "label": "Primary button label" },
    { "type": "url", "id": "button_1_link", "label": "Primary button link" },
    {
      "type": "select", "id": "button_1_style", "label": "Primary button style",
      "options": [ { "value": "primary", "label": "Solid warm white" }, { "value": "secondary", "label": "Gold outline" } ],
      "default": "primary"
    },
    { "type": "text", "id": "button_2_label", "label": "Secondary button label" },
    { "type": "url", "id": "button_2_link", "label": "Secondary button link" },
    { "type": "richtext", "id": "footnote", "label": "Footnote" }
  ],
  "blocks": [
    {
      "type": "contact",
      "name": "Contact",
      "settings": [
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role" },
        { "type": "text", "id": "email", "label": "Email" },
        { "type": "text", "id": "phone", "label": "Phone" }
      ]
    }
  ],
  "presets": [ { "name": "Orloff | Navy CTA" } ]
}
{% endschema %}
