{% render 'og-styles' %}

<div class="og-section">
  {%- comment -%}
    og-section--first goes on the padded element, not the outer wrapper,
    so it can actually override og-pad's top padding.
  {%- endcomment -%}
  <div class="og-wrap og-pad{% if section.settings.reduce_top_space %} og-section--first{% endif %}">
    <div class="og-hero__grid{% if section.settings.image_position == 'left' %} og-hero--media-left{% endif %}">

      <div class="og-hero__text">
        {% render 'og-label', text: section.settings.label %}

        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="og-h1">{{ section.settings.heading }}</{{ section.settings.heading_tag }}>
        {%- endif -%}

        {%- if section.settings.lede != blank -%}
          <p class="og-lede">{{ section.settings.lede }}</p>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="og-body" style="margin-top:1.25rem">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.settings.price_figure != blank -%}
          <div class="og-hero__price">
            <span class="og-hero__price-figure">{{ section.settings.price_figure }}</span>
            {%- if section.settings.price_label != blank -%}
              <span class="og-hero__price-label">{{ section.settings.price_label }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
          <div class="og-btns og-hero__btns">
            {% render 'og-button', label: section.settings.button_1_label, href: section.settings.button_1_link, style: 'primary' %}
            {% render 'og-button', label: section.settings.button_2_label, href: section.settings.button_2_link, style: 'secondary' %}
          </div>
        {%- endif -%}
      </div>

      <div class="og-hero__media">
        {% render 'og-image',
           image: section.settings.image,
           sizes: '(min-width: 900px) 46vw, 100vw',
           priority: true,
           alt: section.settings.image_alt,
           slot_title: section.settings.slot_title,
           slot_text: section.settings.slot_text %}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Orloff | Split hero",
  "tag": "section",
  "class": "og-shopify-section",
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "label", "label": "Section label", "default": "Solar Grown Diamonds" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A diamond is carbon, pressure, and time." },
    {
      "type": "select", "id": "heading_tag", "label": "Heading level",
      "info": "Use H1 once per page.",
      "options": [ { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" } ],
      "default": "h1"
    },
    { "type": "text", "id": "lede", "label": "Introduction", "default": "We simply changed where the time is spent." },
    { "type": "richtext", "id": "body", "label": "Supporting paragraph" },

    { "type": "header", "content": "Headline figure" },
    { "type": "text", "id": "price_figure", "label": "Figure", "info": "Leave blank to hide. Example: 2 600 USD" },
    { "type": "text", "id": "price_label", "label": "Figure label" },

    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_1_label", "label": "Primary button label" },
    { "type": "url", "id": "button_1_link", "label": "Primary button link" },
    { "type": "text", "id": "button_2_label", "label": "Secondary button label" },
    { "type": "url", "id": "button_2_link", "label": "Secondary button link" },

    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "info": "Describes the image for screen readers and search engines." },
    {
      "type": "select", "id": "image_position", "label": "Image position",
      "options": [ { "value": "right", "label": "Right" }, { "value": "left", "label": "Left" } ],
      "default": "right"
    },
    { "type": "text", "id": "slot_title", "label": "Empty slot label", "default": "Hero image" },
    { "type": "text", "id": "slot_text", "label": "Empty slot guidance", "default": "Replaceable. Add the hero photograph in the theme editor." },

    { "type": "header", "content": "Spacing" },
    {
      "type": "checkbox", "id": "reduce_top_space", "label": "Tighten space below the header",
      "default": true,
      "info": "Keep on for the first section of the page."
    }
  ],
  "presets": [ { "name": "Orloff | Split hero" } ]
}
{% endschema %}
