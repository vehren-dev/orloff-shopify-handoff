{%- comment -%}
  Restrained line icons. 1px strokes, no fills, currentColor.

  Accepts:
    icon - key from the list below. "none" or an unknown key renders nothing.
    size - pixel size. Default 24.
{%- endcomment -%}
{%- assign og_icon_size = size | default: 24 -%}
{%- capture og_icon_open -%}<svg xmlns="http://www.w3.org/2000/svg" width="{{ og_icon_size }}" height="{{ og_icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{%- endcapture -%}

{%- case icon -%}
  {%- when 'sun' -%}
    {{ og_icon_open }}<circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/></svg>
  {%- when 'layers' -%}
    {{ og_icon_open }}<path d="M12 3 3 7.5 12 12l9-4.5L12 3Z"/><path d="m3 12.5 9 4.5 9-4.5"/><path d="m3 17 9 4.5L21 17"/></svg>
  {%- when 'diamond' -%}
    {{ og_icon_open }}<path d="M7 3h10l4 6-9 12L3 9l4-6Z"/><path d="M7 3 3 9h18l-4-6"/><path d="m7 3 5 6 5-6M3 9l9 12L21 9"/></svg>
  {%- when 'certificate' -%}
    {{ og_icon_open }}<path d="M5 3h14v11H5z"/><path d="M8 7h8M8 10.5h5"/><path d="m9 14-1 7 4-2.2L16 21l-1-7"/></svg>
  {%- when 'box' -%}
    {{ og_icon_open }}<path d="M3 8.5 12 4l9 4.5v7L12 20l-9-4.5v-7Z"/><path d="M3 8.5 12 13l9-4.5M12 13v7"/></svg>
  {%- when 'camera' -%}
    {{ og_icon_open }}<path d="M3 8h4l1.5-2h7L17 8h4v11H3z"/><circle cx="12" cy="13" r="3.5"/></svg>
  {%- when 'display' -%}
    {{ og_icon_open }}<path d="M3 4h18v11H3z"/><path d="M9 19h6M12 15v4"/></svg>
  {%- when 'academic' -%}
    {{ og_icon_open }}<path d="m12 4 9 4.5-9 4.5-9-4.5L12 4Z"/><path d="M7 11v5c0 1.4 2.2 2.5 5 2.5s5-1.1 5-2.5v-5"/></svg>
  {%- when 'truck' -%}
    {{ og_icon_open }}<path d="M3 6h11v10H3z"/><path d="M14 9h4l3 3v4h-7"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
  {%- when 'ring' -%}
    {{ og_icon_open }}<circle cx="12" cy="14.5" r="6"/><path d="m9.5 6.5 2.5-3 2.5 3"/><path d="m9.5 6.5 2.5 2.6 2.5-2.6z"/></svg>
  {%- when 'handshake' -%}
    {{ og_icon_open }}<path d="m3 11 3-3 4 1 2-1 2 1 4-1 3 3"/><path d="M6 8v8h12V8"/><path d="m10 13 2 2 2-2"/></svg>
  {%- when 'scale' -%}
    {{ og_icon_open }}<path d="M12 4v16M7 20h10"/><path d="M4 9h6l-3 5-3-5ZM14 9h6l-3 5-3-5Z"/><path d="M4 9 12 7l8 2"/></svg>
  {%- when 'document' -%}
    {{ og_icon_open }}<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><path d="M9 12h6M9 16h6"/></svg>
  {%- when 'chat' -%}
    {{ og_icon_open }}<path d="M4 5h16v11H9l-5 4V5Z"/><path d="M8 9h8M8 12h5"/></svg>
  {%- when 'ruler' -%}
    {{ og_icon_open }}<path d="M3 14 14 3l7 7L10 21z"/><path d="m8 9 2 2M11 6l2 2M5 12l2 2"/></svg>
  {%- when 'pin' -%}
    {{ og_icon_open }}<path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
{%- endcase -%}
